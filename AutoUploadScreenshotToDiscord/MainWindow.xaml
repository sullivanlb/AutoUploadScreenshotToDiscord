<Window x:Class="AutoUploadScreenshotToDiscord.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoUploadScreenshotToDiscord" xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        Title="MainWindow" Height="314" Width="390" KeyDown="Window_KeyDown" ResizeMode="CanMinimize" Icon="/Images/icon.ico">
    <Grid Background="#FF5B3FAB">

        <tb:TaskbarIcon IconSource="Images/icon.ico" ToolTipText="UpDiscord">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Background="White">
                    <MenuItem Header="Open" Click="MenuItemOpen_Click" />
                    <MenuItem Header="Hide" Click="MenuItemHide_Click" />
                    <MenuItem Header="Exit" Click="MenuItemExit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <TextBlock HorizontalAlignment="Center" Height="40" Margin="0,10,0,0" TextWrapping="Wrap" Text="UpDiscord" VerticalAlignment="Top" Width="381" FontStretch="SemiCondensed" FontSize="36" TextAlignment="Center" FontFamily="Montserrat Alternates Black" Foreground="White"/>
        <Button Content="F10" HorizontalAlignment="Left" Margin="176,134,0,0" VerticalAlignment="Top" Width="185" Height="29" Click="ChangeShortcutToScreen_Click"/>
        <Label Content="Raccourcis" HorizontalAlignment="Left" Height="28" Margin="23,134,0,0" VerticalAlignment="Top" Width="140" RenderTransformOrigin="0.5,0.5" ClipToBounds="True" SnapsToDevicePixels="True" BorderThickness="2,2,2,2" FontFamily="Montserrat SemiBold" FontSize="14">
            <Label.BorderBrush>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="#FF995CCE" Offset="1"/>
                </LinearGradientBrush>
            </Label.BorderBrush>
            <Label.Background>
                <SolidColorBrush Color="White" Opacity="1"/>
            </Label.Background>
            <Label.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-0.028"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Label.RenderTransform>
        </Label>
        <Button Content="Start" HorizontalAlignment="Center" Height="38" Margin="0,236,0,0" VerticalAlignment="Top" Width="208" Click="Start_Click"/>
        <Label Content="URL du Webhook" HorizontalAlignment="Left" Height="39" Margin="21,70,0,0" VerticalAlignment="Top" Width="142" RenderTransformOrigin="0.5,0.5" ClipToBounds="True" SnapsToDevicePixels="True" Background="White" BorderThickness="2,2,2,2" FontFamily="Montserrat SemiBold">
            <Label.BorderBrush>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="#FF995CCE" Offset="1"/>
                </LinearGradientBrush>
            </Label.BorderBrush>
            <Label.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-0.028"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Label.RenderTransform>
        </Label>
        <TextBox x:Name="URLTextBox" x:FieldModifier="public" HorizontalAlignment="Left" Margin="180,70,0,0" TextWrapping="Wrap" Text="URL" VerticalAlignment="Top" Width="185" Height="40" Background="White" CaretBrush="#FFB700FF" UndoLimit="500" Cursor="IBeam">
            <TextBox.BorderBrush>
                <SolidColorBrush Color="#FFABADB3" Opacity="0"/>
            </TextBox.BorderBrush>
        </TextBox>
        <Separator HorizontalAlignment="Center" Margin="0,110,0,0" VerticalAlignment="Top" Height="24" Width="332"/>
        <Button Content="Choisir le fichier temporaire" HorizontalAlignment="Center" Margin="0,179,0,0" VerticalAlignment="Top" Click="TempPathFileButton_Click" Width="208"/>
        <TextBox x:Name="TempPathFileTextBox" HorizontalAlignment="Center" Margin="0,204,0,0" TextWrapping="Wrap" Text="ex: C:/temp" VerticalAlignment="Top" Width="208" Foreground="White" BorderBrush="White" IsReadOnly="True" TextAlignment="Center">
            <TextBox.Background>
                <SolidColorBrush Color="White" Opacity="0"/>
            </TextBox.Background>
        </TextBox>

    </Grid>
</Window>
